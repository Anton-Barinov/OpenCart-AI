    "opencart",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "cursor",
    "chatgpt",
    "ecommerce",
    "ocmod",
    "ai-agent"
  ],
  "homepage": "https://github.com/Anton-Barinov/OpenCart-AI",
  "license": "MIT",
  "authors": [
    {
      "name": "Anton Barinov",
      "homepage": "https://github.com/Anton-Barinov"
    }
  ],
  "type": "opencart-extension",
  "require": {
    "php": ">=5.4.0"
  },
  "autoload": {
    "psr-4": {
      "OpenCartMcp\\": "upload/system/library/opencart_ai/"
    }
  },
  "scripts": {
    "test": "php tests/run_tests.php",
    "package": "bin/package-ocmod"
  },
  "config": {
